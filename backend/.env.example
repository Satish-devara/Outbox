# Server
PORT=3001
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# PostgreSQL (use either DATABASE_URL or individual host/port fields)
DATABASE_URL=postgres://outbox_user:outbox_pass@localhost:5433/outbox_db
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=outbox_db
# DB_USER=outbox_user
# DB_PASSWORD=outbox_pass

# Redis (use either REDIS_URL or host/port)
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Worker Concurrency & Provider Throttling
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=1000
